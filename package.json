{
  "name": "creator-data-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform creator analytics Chrome extension with AI-ready exports",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --parallel --filter @creator-data-bridge/api --filter @creator-data-bridge/extension dev",
    "format": "biome check --write .",
    "lint": "biome check .",
    "secrets:generate": "node scripts/generate-token-key.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
